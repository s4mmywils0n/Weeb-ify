<?php

declare(strict_types=1);

namespace App\Models;

use App\Services\SupabaseService;
use RuntimeException;

class AccountModel
{
    private ?int $id;
    private string $firstName;
    private string $username;
    private string $email;
    private string $phoneNumber;
    private string $password;
    private \DateTime $createdAt;
    protected SupabaseService $supabase;

    public function __construct(
        ?int $id = null,
        string $firstName = '',
        string $username = '',
        string $email = '',
        string $phoneNumber = '',
        string $password = '',
        \DateTime $createdAt = new \DateTime(),
        ?SupabaseService $dbService = null
    ) {
        $this->id = $id;
        $this->firstName = $firstName;
        $this->username = $username;
        $this->email = $email;
        $this->phoneNumber = $phoneNumber;
        $this->password = $password;
        $this->createdAt = $createdAt;
        $this->supabase = $dbService ?? new SupabaseService();
    }

    public function getId(): ?int
    {
        return $this->id;
    }

    public function getFirstName(): string
    {
        return $this->firstName;
    }

    public function getUsername(): string
    {
        return $this->username;
    }

    public function getEmail(): string
    {
        return $this->email;
    }

    public function getPhoneNumber(): string
    {
        return $this->phoneNumber;
    }

    public function getPassword(): string
    {
        return $this->password;
    }

    public function getCreatedAt(): \DateTime
    {
        return $this->createdAt;
    }

    public function Validate(string $firstName, string $username, string $email, string $phoneNumber, string $password): array
    {
        $errors = [];

        if ($firstName === '') {
            $errors[] = 'First name cannot be empty.';
        } elseif (preg_match('/\A[A-Za-z]{8,}\z/', $firstName) !== 1) {
            $errors[] = 'First name must be at least 8 characters long and contain only letters.';
        }

        if ($username === '') {
            $errors[] = 'Username cannot be empty.';
        } elseif (preg_match('/\A(?=.*[A-Za-z]).{4,}\z/', $username) !== 1) {
            $errors[] = 'Username must be at least 4 characters long and contain at least one letter.';
        }

        if ($email === '') {
            $errors[] = 'Email cannot be empty.';
        } elseif (preg_match('/\A[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\z/i', $email) !== 1) {
            $errors[] = 'Please provide a valid email address.';
        }

        if ($password === '') {
            $errors[] = 'Password cannot be empty.';
        } elseif (preg_match('/\A(?=.*[A-Za-z])(?=.*\d).{8,}\z/', $password) !== 1) {
            $errors[] = 'Password must be at least 8 characters long and contain a letter and a number.';
        }

        return $errors;
    }

    public function createAccount(string $firstName, string $username, string $email, string $phoneNumber, string $password): void
    {
        $this->firstName = trim($firstName);
        $this->username = trim($username);
        $this->email = strtolower(trim($email));
        $this->phoneNumber = trim($phoneNumber);
        $this->password = password_hash($password, PASSWORD_DEFAULT);

        $insertedRows = $this->supabase->insert('accounts', [
            'first_name' => $this->firstName,
            'username' => $this->username,
            'email' => $this->email,
            'phone_number' => $this->phoneNumber,
            'password_hash' => $this->password,
        ]);

        if (!isset($insertedRows[0]['id'])) {
            throw new RuntimeException('Supabase did not return the created account.');
        }

        $this->fromArray($insertedRows[0]);
    }

    public function fromArray(array $data): void
    {
        $this->id = isset($data['id']) ? (int) $data['id'] : null;
        $this->firstName = $data['first_name'] ?? $data['firstName'] ?? '';
        $this->username = $data['username'] ?? '';
        $this->email = $data['email'] ?? '';
        $this->phoneNumber = $data['phone_number'] ?? $data['phoneNumber'] ?? '';
        $this->password = $data['password_hash'] ?? $data['password'] ?? '';
        $this->createdAt = $data['created_at'] ?? $data['createdAt'] ?? new \DateTime();
    }

    public function toArray(): array
    {
        return [
            'id' => $this->id,
            'first_name' => $this->firstName,
            'username' => $this->username,
            'email' => $this->email,
            'phone_number' => $this->phoneNumber,
            'created_at' => $this->createdAt,
        ];
    }
}
